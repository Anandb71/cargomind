# Copy to .env (repo root). EVERYTHING IS OPTIONAL - with no keys CargoMind runs in offline mode.

# Default primary provider: native OpenAI Responses. Keys stay in .env only.
CARGOMIND_PROVIDER=openai
CARGOMIND_OPENAI_FAST=gpt-6-luna
CARGOMIND_OPENAI_PRO=gpt-6.1-sol
CARGOMIND_OPENAI_CRITIC=gpt-6.1-sol
CARGOMIND_JUDGE_MODEL=gpt-6.1-sol
CARGOMIND_SEMANTIC_JUDGE=1

# Optional legacy Gemini chain: set CARGOMIND_PROVIDER=multi with available quota.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false

# Google Maps Platform (Routes API + Geocoding API enabled). Fallback: OSRM/OpenStreetMap
GOOGLE_MAPS_API_KEY=

# Second vendor model (independent critic + cross-provider failover). Either works.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides
# CARGOMIND_GEMINI_FAST=gemini-3.5-flash
# CARGOMIND_GEMINI_PRO=gemini-3.1-pro-preview
# CARGOMIND_CLAUDE_MODEL=anthropic/claude-sonnet-5-5
# CARGOMIND_OPENAI_MODEL=openai/gpt-5-mini
# CARGOMIND_OFFLINE=false        # force offline rule-engine
# CARGOMIND_CHAOS=0              # 0..1 fault-injection rate (demo self-healing)
